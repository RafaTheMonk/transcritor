#!/usr/bin/env bash
# Lancador da CLI do Transcritor. Unico lugar que define LD_LIBRARY_PATH.
set -euo pipefail

ARQ="$(readlink -f "${BASH_SOURCE[0]}")"
RAIZ="$(dirname "$(dirname "$ARQ")")"
PY="$RAIZ/.venv/bin/python"

if [ ! -x "$PY" ]; then
    echo "ERRO: ambiente não encontrado em $RAIZ/.venv. Rode $RAIZ/instalar.sh" >&2
    exit 1
fi

LIBS=""
for d in "$RAIZ"/.venv/lib/python*/site-packages/nvidia/cublas/lib \
         "$RAIZ"/.venv/lib/python*/site-packages/nvidia/cudnn/lib; do
    [ -d "$d" ] && LIBS="${LIBS:+$LIBS:}$d"
done
if [ -n "$LIBS" ]; then
    export LD_LIBRARY_PATH="$LIBS${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
export PYTHONPATH="$RAIZ${PYTHONPATH:+:$PYTHONPATH}"

exec "$PY" -P -m transcritor.cli "$@"
