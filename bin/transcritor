#!/usr/bin/env bash
# Lancador da interface grafica do Transcritor. A janela nao usa a GPU: quem define
# LD_LIBRARY_PATH e so bin/transcrever, que ela roda como subprocesso.
set -euo pipefail

ARQ="$(readlink -f "${BASH_SOURCE[0]}")"
RAIZ="$(dirname "$(dirname "$ARQ")")"
PY="$RAIZ/.venv/bin/python"

if [ ! -x "$PY" ]; then
    echo "ERRO: ambiente não encontrado em $RAIZ/.venv. Rode $RAIZ/instalar.sh" >&2
    exit 1
fi

# Troca a pasta atual (sys.path[0]) pela do projeto, para um .py solto na pasta de onde se
# roda nunca ser importado. Vale para qualquer Python: a opção -P só existe a partir do 3.11.
exec "$PY" -c 'import sys; sys.path[0] = sys.argv.pop(1); from transcritor.gui import main; sys.exit(main())' "$RAIZ" "$@"
